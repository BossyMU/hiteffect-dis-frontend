# Base URL of hiteffect-dis-backend (including the /api prefix). Optional.
# Without it, `npm run dev` sends /api to the local backend on localhost:3000 (proxy in vite.config.ts),
# and `npm run build` uses the hosted backend on Vercel (see src/api/client.ts).
# Uncomment a line only to point at a different backend.
# VITE_API_BASE_URL=https://hiteffect-dis-backend.vercel.app/api
